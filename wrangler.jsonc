{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skill-issue-society",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sis-db",
      "database_id": "67abf173-cdec-4592-9770-3749fe9e0467"
    }
  ],
  "observability": { "enabled": true }
}
